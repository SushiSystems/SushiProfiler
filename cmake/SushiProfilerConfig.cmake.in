@PACKAGE_INIT@

# What find_package(SushiProfiler) gives a consumer: SushiProfiler::SushiProfiler. It carries
# this tree's include roots and Threads, and neither its warnings nor its sanitizer.

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SushiProfilerTargets.cmake")

check_required_components(SushiProfiler)
